{
  "description": "The directory shown (and queried by git) is the last existing location a tool call named, climbed to its git root; bookkeeping under ~/.claude/projects and vanished paths are skipped.",
  "stdin": {
    "model": {
      "display_name": "Opus 5"
    },
    "workspace": {
      "current_dir": "{{home}}/work/atlas"
    },
    "context_window": {
      "used_percentage": 20,
      "context_window_size": 200000
    },
    "rate_limits": {
      "five_hour": {
        "used_percentage": 20,
        "resets_at": "{{epoch:+12000}}"
      }
    },
    "effort": {
      "level": "high"
    },
    "session_id": "parity-session-0003",
    "transcript_path": "{{home}}/.claude/projects/-work-atlas/parity-session-0003.jsonl"
  },
  "repos": [
    {
      "dir": "home/work/atlas",
      "branch": "main",
      "commit": {
        "README.md": "atlas\n"
      }
    },
    {
      "dir": "home/work/other",
      "branch": "fix/other",
      "commit": {
        "sub/x.txt": "x\n"
      },
      "modify": {
        "sub/x.txt": "y\n"
      },
      "worktrees": [
        "home/work/other-wt",
        "!home/work/other-gone"
      ]
    }
  ],
  "files": {
    "home/.claude/projects/-work-atlas/parity-session-0003.jsonl": [
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "tool_use",
              "id": "t1",
              "name": "Read",
              "input": {
                "file_path": "{{home}}/work/atlas/README.md"
              }
            }
          ]
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "tool_use",
              "id": "t2",
              "name": "Bash",
              "input": {
                "command": "cd '{{home}}/work/other/sub' && make"
              }
            }
          ]
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "tool_use",
              "id": "t3",
              "name": "Read",
              "input": {
                "file_path": "{{home}}/.claude/projects/-work-atlas/memory.md"
              }
            }
          ]
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "tool_use",
              "id": "t4",
              "name": "Read",
              "input": {
                "file_path": "{{home}}/gone/away.txt"
              }
            }
          ]
        }
      }
    ],
    "home/.claude/projects/-work-atlas/memory.md": "m\n"
  },
  "variants": [
    {
      "name": "default"
    },
    {
      "name": "cols-200",
      "env": {
        "COLUMNS": "200"
      }
    }
  ],
  "env": {
    "COLORTERM": "truecolor"
  }
}