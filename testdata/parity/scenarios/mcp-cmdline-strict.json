{
  "description": "--strict-mcp-config: only managed and command-line servers count.",
  "stdin": {
    "model": {
      "display_name": "Opus 5"
    },
    "workspace": {
      "current_dir": "{{home}}/work/atlas"
    },
    "context_window": {
      "used_percentage": 20,
      "context_window_size": 200000
    },
    "rate_limits": {
      "five_hour": {
        "used_percentage": 20,
        "resets_at": "{{epoch:+12000}}"
      }
    },
    "effort": {
      "level": "high"
    },
    "session_id": "parity-session-0003",
    "transcript_path": "{{home}}/.claude/projects/-work-atlas/parity-session-0003.jsonl"
  },
  "repos": [
    {
      "dir": "home/work/atlas",
      "branch": "main",
      "commit": {
        "README.md": "atlas\n"
      }
    }
  ],
  "host": {
    "args": [
      "--strict-mcp-config",
      "--mcp-config",
      "{\"mcpServers\":{\"only\":{}}}"
    ],
    "cwd": "home/work/atlas"
  },
  "files": {
    "home/.claude/sessions/{{pid}}.json": {
      "pid": "{{pid}}",
      "sessionId": "parity-session-0003",
      "status": "idle"
    },
    "home/.claude.json": {
      "mcpServers": {
        "user-one": {},
        "user-two": {}
      }
    },
    "home/work/atlas/.mcp.json": {
      "mcpServers": {
        "proj": {}
      }
    }
  },
  "env": {
    "COLORTERM": "truecolor"
  }
}