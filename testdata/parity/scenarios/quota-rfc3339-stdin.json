{
  "description": "resets_at as an RFC 3339 string on stdin decodes like the epoch form.",
  "stdin": {
    "model": {
      "display_name": "Opus 5"
    },
    "workspace": {
      "current_dir": "{{home}}"
    },
    "context_window": {
      "used_percentage": 30
    },
    "rate_limits": {
      "five_hour": {
        "used_percentage": 50,
        "resets_at": "{{rfc3339:+9000}}"
      }
    }
  },
  "env": {
    "COLORTERM": "truecolor"
  }
}