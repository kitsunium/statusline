{
  "description": "Model pill for 'Fable 5.1', effort 'medium', fast mode False.",
  "env": {
    "COLORTERM": "truecolor",
    "COLUMNS": "160"
  },
  "stdin": {
    "model": {
      "display_name": "Fable 5.1"
    },
    "workspace": {
      "current_dir": "{{home}}"
    },
    "context_window": {
      "used_percentage": 97,
      "context_window_size": 200000
    },
    "rate_limits": {
      "five_hour": {
        "utilization": 88,
        "resets_at": "{{epoch:+600}}"
      },
      "seven_day": {
        "used_percentage": 12.7,
        "resets_at": "{{epoch:+500000}}"
      }
    },
    "fast_mode": false,
    "effort": {
      "level": "medium"
    }
  },
  "variants": [
    {
      "name": "default"
    },
    {
      "name": "colors-256",
      "env": {
        "STATUSLINE_COLORS": "256"
      }
    }
  ]
}